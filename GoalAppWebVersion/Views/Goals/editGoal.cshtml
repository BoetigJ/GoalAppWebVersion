@{
}

@model GoalAppWebVersion.Models.GoalViewModel

<h1>Edit Goal</h1>

<form method ="post">

    <div class="mt-3">
        <label class="form-label">Id</label>
        <input type="text" class="form-control" asp-for="Id" readonly />
    </div> 
    <div class="mt-3">

        <label class="form-label">Name</label>
        <input type="text" class="form-control" asp-for="Name" />
    </div>
    <div class="mt-3">

        <label class="form-label">Description</label>
        <input type="text" class="form-control" asp-for="Description" />
    </div>
    <div class="mt-3">

        <label class="form-label">Streak</label>
        <input type="number" class="form-control" asp-for="Streak" />
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save Goal</button>
        <button type="submit" class="btn btn-danger" asp-action="DeleteGoal">Delete Goal</button>
</form>
