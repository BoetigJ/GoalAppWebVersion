@{
}
@model List<GoalAppWebVersion.Models.Entities.Goal>
@using GoalAppWebVersion.Models.Entities

<h1>Goals</h1>

@if (TempData["Message"] != null)
{
	<div class="alert alert-success">@TempData["Message"]</div>
}

<table class="table">
	<thead>
		<tr>
			
			<th>Goal Name</th>
			<th>Goal Type</th>
			<th>Goal Description</th>
			<th>Streak</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var goal in Model)
		{
			var goalType = goal switch
			{
				ExerciseGoal => "Exercise",
				HabitMakeGoal => "Habit Building",
				HabitBreakGoal => "Habit Breaking",
				_ => "Unknown"
			};
			<tr>
				
				<td>@goal.Name</td>
				<td>@goalType</td>
				<td>@goal.Description</td>
				<td>@goal.Streak</td>
				<td><div class="goal-actions">
					@if (goal is GoalAppWebVersion.Models.Entities.ITrackable)
					{
						<form asp-controller="Goals" asp-action="RecordProgress" asp-route-id="@goal.Id" method="post">
							<button type="submit" class="btn btn-primary">Record progress</button>
						</form>
					}
					@if (goal is IResettable)
					{
						<form asp-controller="Goals" asp-action="Reset" asp-route-id="@goal.Id" method="post">
							<button type="submit" class="btn btn-primary">Reset</button>
						</form>
					}

					<a class="btn btn-primary" asp-controller="Goals" asp-action="editGoal" asp-route-id="@goal.Id">Edit</a>
					<form asp-controller="Goals" asp-action="DeleteGoal" asp-route-id="@goal.Id" method="post"
						  onsubmit="return confirm('Delete this goal?');">
						<button type="submit" class="btn btn-primary">Delete</button>
					</form>
				</div></td>
			</tr>
		}
	</tbody>
</table>