@model GoalAppWebVersion.Models.GoalViewModel

<h1>Add Goal</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mt-3">
        <label class="form-label" asp-for="Name">Goal Title</label>
        <input class="form-control" type="text" asp-for="Name" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mt-3">
        <label class="form-label" asp-for="Description">Description</label>
        <input class="form-control" type="text" asp-for="Description" />
    </div>

    <div class="mt-3">
        <label class="form-label" asp-for="GoalType">Goal Type</label>
        <select class="form-select" asp-for="GoalType">
            <option value="">-- Select a type --</option>
            <option value="HabitMake">Build a habit</option>
            <option value="HabitBreak">Break a habit</option>
            <option value="Exercise">Exercise</option>
        </select>
        <span asp-validation-for="GoalType" class="text-danger"></span>
    </div>

    <div class="mt-3">
        <label class="form-label" asp-for="HowOften">How Often</label>
        <input class="form-control" type="text" asp-for="HowOften" />
    </div>

    <div class="mt-3">
        <label class="form-label" asp-for="ReminderFrequency">Reminder Frequency</label>
        <input class="form-control" type="text" asp-for="ReminderFrequency" />
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save Goal</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}